parse_git_branch() {
  local git_status
  git rev-parse --git-dir &>/dev/null || return
  git_status="$(git status 2>/dev/null)"

  local branch remote state

  # Fast, language-agnostic dirty check using --porcelain
  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    state="⚡"
  fi

  if [[ "${git_status}" =~ "Your branch is ahead" ]]; then
    remote="↑"
  elif [[ "${git_status}" =~ "Your branch is behind" ]]; then
    remote="↓"
  elif [[ "${git_status}" =~ "have diverged" ]]; then
    remote="↕"
  fi

  if [[ "${git_status}" =~ "On branch " ]]; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    printf "(%s)%s%s" "$branch" "${remote:-}" "${state:-}"
  elif [[ "${git_status}" =~ "HEAD detached" ]]; then
    branch=$(git rev-parse --short HEAD 2>/dev/null)
    printf "(%s)%s%s" "$branch" "${remote:-}" "${state:-}"
  fi
}

prompt_func() {
  local ret=$?
  local user_color="\[\e[1;32m\]"   # bright green
  local host_color="\[\e[1;36m\]"   # bright cyan
  local path_color="\[\e[1;34m\]"   # bright blue
  local git_color="\[\e[0;32m\]"    # green for git branch
  local reset="\[\e[0m\]"
  local err_color="\[\e[0;31m\]"    # red for error

  local git_info
  git_info="$(parse_git_branch)"
  if [ -n "$git_info" ]; then
    git_info=" ${git_color}${git_info}"
  fi

  local prompt_symbol="$"
  [ "$EUID" -eq 0 ] && prompt_symbol="#"

  # Terminal/tab title escape sequence (properly wrapped in \[ \])
  local title="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]"

  PS1="${title}${user_color}\u${host_color}@\h${path_color}:\w${git_info}${reset} ${prompt_symbol} "

  if [ $ret -ne 0 ]; then
    PS1="${PS1}${err_color}✘${reset} "
  fi
}

export PROMPT_COMMAND=prompt_func
